# Neon Postgres (pooled connection for the app)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/ucup2026?sslmode=require"
# Neon direct connection (used by Prisma Migrate)
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/ucup2026?sslmode=require"

JWT_SECRET="change-me-to-a-long-random-string"

# Used to build absolute URLs in metadata, Open Graph tags, and the sitemap.
# Set this to your real production URL once deployed (no trailing slash).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Vercel Blob: create a Blob store in your Vercel project dashboard
# (Storage tab) — it gives you this token automatically once connected.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# Pusher Channels (free Sandbox plan): create an app at dashboard.pusher.com
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""

# Shared code given by coaches/organizers to legitimate players before they
# can submit a self-registration request (still requires admin approval).
REGISTRATION_CODE="change-me-too"

# Email notifications to admins (new registration, match going live) — free
# tier at resend.com. Leave empty to disable (no crash, just no emails).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="UCUP 2026 <onboarding@resend.dev>"

# Browser push notifications — generate a key pair once with:
#   npx web-push generate-vapid-keys
# The public key is safe to expose (NEXT_PUBLIC_), the private key must stay secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT_EMAIL="contact@ucup2026.cg"
